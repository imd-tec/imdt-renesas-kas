# IMDT Renesas BSP - Development Configuration

mainmenu "IMDT Renesas BSP"

config KAS_BUILD_SYSTEM
    string
    default "openembedded"

# =============================================================================
# Base Configuration (always included)
# =============================================================================
config KAS_INCLUDE_BASE
    string
    default "includes/base.yml"
    default "includes/imdt.yml"
    help
      Base layer configuration - always included first.
      Defines poky, meta-openembedded, meta-renesas and other core layers.

config KAS_INCLUDE_IMDT
    string
    default "includes/imdt.yml"
    help
      Base layer configuration - always included first.
      Defines poky, meta-openembedded, meta-renesas and other core layers.

# =============================================================================
# Target SoC Selection
# =============================================================================
choice
    prompt "Target SoC"
    default MACHINE_V2H

config MACHINE_V2H
    bool "V2H (imdt-v2h-sbc)"
    help
      Build for the Renesas RZ/V2H platform.

config MACHINE_V2N
    bool "V2N (imdt-v2n-sbc)"
    help
      Build for the Renesas RZ/V2N platform.

endchoice

config KAS_INCLUDE_MACHINE
    string
    default "machine/v2h.yml" if MACHINE_V2H
    default "machine/v2n.yml" if MACHINE_V2N

# =============================================================================
# Graphics Support (Proprietary)
# =============================================================================
menu "Graphics"

config GRAPHICS_ENABLE
    bool "Enable Graphics support (proprietary)"
    default y
    help
      Include proprietary graphics support.
      Requires SSH access to proprietary repositories.

config KAS_INCLUDE_GRAPHICS
    string
    depends on GRAPHICS_ENABLE
    default "features/graphics.yml"

endmenu

# =============================================================================
# AI/ML Acceleration Features
# =============================================================================
menu "AI/ML Acceleration"

if MACHINE_V2H

config V2H_DRPAI
    bool "DRP-AI (V2H)"
    default y
    help
      Enable DRP-AI acceleration for V2H.

config KAS_INCLUDE_V2H_DRPAI
    string
    depends on V2H_DRPAI
    default "features/v2h-drpai.yml"

config V2H_ACCEL_ENABLE
    bool "Enable Codec/OpenCVA (V2H)"
    default y
    help
      Enable hardware acceleration selection for V2H.
      Choose between Video Codecs or OpenCV Accelerator.

if V2H_ACCEL_ENABLE

choice
    prompt "V2H Codec/OpenCVA Selection"
    default V2H_CODECS

config V2H_CODECS
    bool "Video Codecs (proprietary)"
    help
      Enable hardware video codec support for V2H.

config V2H_OPENCVA
    bool "OpenCV Accelerator"
    help
      Enable OpenCV hardware acceleration for V2H.

endchoice

endif # V2H_ACCEL_ENABLE

config KAS_INCLUDE_V2H_CODECS
    string
    depends on V2H_CODECS
    default "features/codecs.yml"

config KAS_INCLUDE_V2H_OPENCVA
    string
    depends on V2H_OPENCVA
    default "features/v2h-opencva.yml"

endif # MACHINE_V2H

if MACHINE_V2N

config V2N_ACCEL_ENABLE
    bool "Enable Accelerator (V2N)"
    default y
    help
      Enable hardware acceleration selection for V2N.
      Choose between DRP-AI, Video Codecs, or OpenCV Accelerator.

if V2N_ACCEL_ENABLE

choice
    prompt "V2N Accelerator Selection"
    default V2N_DRPAI

config V2N_DRPAI
    bool "DRP-AI"
    help
      Enable DRP-AI acceleration for V2N.

config V2N_CODECS
    bool "Video Codecs (proprietary)"
    help
      Enable hardware video codec support for V2N.

config V2N_OPENCVA
    bool "OpenCV Accelerator"
    help
      Enable OpenCV hardware acceleration for V2N.

endchoice

endif # V2N_ACCEL_ENABLE

config KAS_INCLUDE_V2N_DRPAI
    string
    depends on V2N_DRPAI
    default "features/v2n-drpai.yml"

config KAS_INCLUDE_V2N_CODECS
    string
    depends on V2N_CODECS
    default "features/codecs.yml"

config KAS_INCLUDE_V2N_OPENCVA
    string
    depends on V2N_OPENCVA
    default "features/v2n-opencva.yml"

endif # MACHINE_V2N

endmenu

# =============================================================================
# ISP (Image Signal Processor) Support (Proprietary)
# =============================================================================
menu "ISP Support"

config ISP_ENABLE
    bool "Enable ISP support (proprietary)"
    default y
    help
      Include proprietary ISP (Image Signal Processor) support.
      Requires SSH access to proprietary repositories.

config KAS_INCLUDE_ISP
    string
    depends on ISP_ENABLE
    default "features/isp.yml"

config KAS_INCLUDE_ISP_IMDT
    string
    depends on ISP_ENABLE
    default "includes/imdt-isp.yml"

endmenu

# =============================================================================
# Target Image
# =============================================================================
menu "Target Image"

choice
    prompt "Image type"
    default IMAGE_ISP

config IMAGE_WESTON
    bool "Weston (Wayland compositor)"
    help
      Build a graphical image with Weston compositor.

config IMAGE_CORE
    bool "Core (minimal)"
    help
      Build a minimal console image.

config IMAGE_ISP
    bool "ISP Development"
    depends on ISP_ENABLE
    help
      Build an ISP-focused development image.

endchoice

config KAS_INCLUDE_IMAGE
    string
    default "images/weston.yml" if IMAGE_WESTON
    default "images/core.yml" if IMAGE_CORE
    default "images/isp.yml" if IMAGE_ISP

endmenu

